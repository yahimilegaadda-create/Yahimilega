<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YahiMilega - Yaha Sab Kuch Milega</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
<style>body{font-family:'Poppins',sans-serif}</style>
</head>
<body class="bg-[#FFF8F0]">
<!-- Header -->
<header class="bg-white shadow-sm sticky top-0 z-50">
<div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
<h1 class="text-2xl font-bold"><span class="text-orange-500">Yahi</span><span class="text-black">Milega</span> <span class="text-xs bg-black text-white px-2 py-1 rounded-full">SAB KUCH</span></h1>
<button class="bg-black text-white px-4 py-2 rounded-full text-sm">Search</button>
</div>
</header>

<!-- Hero -->
<div class="max-w-6xl mx-auto px-4 py-6">
<div class="bg-gradient-to-r from-orange-500 to-red-500 rounded-[30px] p-6 md:p-8 text-white">
<h2 class="text-3xl md:text-4xl font-bold leading-tight">Yaha Sab Kuch Milega,<br>Ek Hi Jagah!</h2>
<p class="mt-2 opacity-90">Shayari, Sarkari Result, Govt Job, College Notes...</p>
<div class="mt-4 flex gap-2"><span class="bg-white/20 px-3 py-1 rounded-full text-sm">Shayari</span><span class="bg-white/20 px-3 py-1 rounded-full text-sm">Result</span><span class="bg-white/20 px-3 py-1 rounded-full text-sm">Jobs</span></div>
</div>
</div>

<!-- Categories Grid -->
<div class="max-w-6xl mx-auto px-4 pb-20 grid grid-cols-1 md:grid-cols-2 gap-5">

<!-- Shayari -->
<div class="bg-white rounded-[25px] p-5 shadow-sm border">
<h3 class="font-bold text-lg mb-3">📝 Shayari Adda</h3>
<div class="grid grid-cols-2 gap-2">
<a class="bg-pink-50 p-3 rounded-xl text-center text-sm font-semibold">❤️ Love Shayari</a>
<a class="bg-blue-50 p-3 rounded-xl text-center text-sm font-semibold">💔 Dard Shayari</a>
<a class="bg-green-50 p-3 rounded-xl text-center text-sm font-semibold">🤝 Dosti Shayari</a>
<a class="bg-purple-50 p-3 rounded-xl text-center text-sm font-semibold">😎 Attitude</a>
</div>
</div>

<!-- Govt Job -->
<div class="bg-white rounded-[25px] p-5 shadow-sm border">
<h3 class="font-bold text-lg mb-3">💼 Govt Job & Yojana</h3>
<div class="grid grid-cols-2 gap-2">
<a class="bg-orange-50 p-3 rounded-xl text-center text-sm font-semibold">🚂 Railway</a>
<a class="bg-yellow-50 p-3 rounded-xl text-center text-sm font-semibold">👮 Police / Army</a>
<a class="bg-red-50 p-3 rounded-xl text-center text-sm font-semibold">📚 SSC / UPSC</a>
<a class="bg-indigo-50 p-3 rounded-xl text-center text-sm font-semibold">💰 Sarkari Yojana</a>
</div>
</div>

<!-- Result -->
<div class="bg-white rounded-[25px] p-5 shadow-sm border">
<h3 class="font-bold text-lg mb-3">🎓 Result & Admit Card</h3>
<div class="grid grid-cols-2 gap-2">
<a class="bg-slate-50 p-3 rounded-xl text-center text-sm font-semibold">10th Result</a>
<a class="bg-slate-50 p-3 rounded-xl text-center text-sm font-semibold">12th Result</a>
<a class="bg-slate-50 p-3 rounded-xl text-center text-sm font-semibold">University Result</a>
<a class="bg-slate-50 p-3 rounded-xl text-center text-sm font-semibold">Admit Card</a>
</div>
</div>

<!-- School College -->
<div class="bg-white rounded-[25px] p-5 shadow-sm border">
<h3 class="font-bold text-lg mb-3">🏫 School / College Gyan</h3>
<div class="grid grid-cols-2 gap-2">
<a class="bg-teal-50 p-3 rounded-xl text-center text-sm font-semibold">Class 9-12 Notes</a>
<a class="bg-cyan-50 p-3 rounded-xl text-center text-sm font-semibold">BA / BSc / MA</a>
<a class="bg-lime-50 p-3 rounded-xl text-center text-sm font-semibold">Fashion / Mehndi</a>
<a class="bg-amber-50 p-3 rounded-xl text-center text-sm font-semibold">Meme / Jokes</a>
</div>
</div>

</div>

<footer class="text-center py-6 text-gray-400 text-sm">© 2026 YahiMilega - Made with ❤️ in India</footer>
</body>
</html>
